{
  "name": "pihole-export",
  "version": "0.2.0",
  "description": "Keyboard-first Pi-hole v6 query log exporter",
  "type": "module",
  "bin": {
    "pihole-export": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "compile": "bun src/build.ts",
    "fmt": "oxfmt --write src test",
    "lint": "oxlint src",
    "check": "oxfmt --check src test && oxlint src && tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.1.5",
    "@opentui/core": "^0.9.9",
    "@opentui/solid": "^0.9.9",
    "effect": "^4.1.5",
    "solid-js": "1.9.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "hyparquet": "1.33.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "Apache-2.0",
  "private": false
}
