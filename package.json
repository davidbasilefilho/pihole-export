{
  "name": "pihole-export",
  "version": "0.1.3",
  "description": "Keyboard-first Pi-hole v6 query log exporter",
  "type": "module",
  "bin": {
    "pihole-export": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "compile": "bun src/build.ts",
    "fmt": "oxfmt --write src",
    "lint": "oxlint --fix src",
    "check": "bun run fmt && bun run lint",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@tuiparts/solid": "^0.0.6",
    "effect": "^3.22.1",
    "hyparquet-writer": "^0.12.3",
    "lefthook": "^2.1.12",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "Apache-2.0",
  "private": false
}
